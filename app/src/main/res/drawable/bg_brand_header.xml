<?xml version="1.0" encoding="utf-8"?>
<!-- GeoStamp Brand Header Background v5.3
     TOP corners = 0dp  → flush with screen left/right/top edges
     BOTTOM corners = 16dp → soft curve at banner bottom edge
     Background = pure black to match logo PNGs -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
            <corners android:topLeftRadius="0dp"
                     android:topRightRadius="0dp"
                     android:bottomLeftRadius="16dp"
                     android:bottomRightRadius="16dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="#3D8B5CF6"/>
            <corners android:topLeftRadius="0dp"
                     android:topRightRadius="0dp"
                     android:bottomLeftRadius="16dp"
                     android:bottomRightRadius="16dp"/>
        </shape>
    </item>
</layer-list>

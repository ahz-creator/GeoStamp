<?xml version="1.0" encoding="utf-8"?>
<!--
    ControlButtonCard background — glassmorphism style
    Used by: Gallery button, Settings button
    Visual: dark navy/indigo gradient + subtle blue-purple border + soft outer halo
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40A0C0FF">

    <!-- Ripple mask — rounded to match card shape -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <item>
        <layer-list>
            <!-- Layer 1: soft outer glow halo (semi-transparent purple/blue bleed) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#15304080"/>
                    <corners android:radius="19dp"/>
                </shape>
            </item>

            <!-- Layer 2: main glass card — dark navy gradient + subtle colored border -->
            <item android:left="1dp" android:top="1dp"
                  android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#131A32"
                        android:endColor="#170E28"
                        android:angle="135"/>
                    <stroke android:width="1dp" android:color="#2A3864"/>
                    <corners android:radius="17dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer cyan glow -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2022D3EE"/>
            <corners android:radius="100dp"/>
        </shape>
    </item>
    <!-- Glass body -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#1A22D3EE" android:endColor="#0C0F2040" android:angle="135"/>
            <corners android:radius="100dp"/>
            <stroke android:width="1dp" android:color="#6022D3EE"/>
        </shape>
    </item>
</layer-list>

<?xml version="1.0" encoding="utf-8"?>
<!--
    GlowSelectionCard background — premium amber/gold neon border
    Used by: Operator card, Site ID card
    Visual: very dark amber background + bright glowing gold border + outer glow bleed
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#50FBBF24">

    <!-- Ripple mask -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <item>
        <layer-list>
            <!-- Layer 1: outer soft glow bleed (semi-transparent gold diffusion) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#22FBBF24"/>
                    <corners android:radius="19dp"/>
                </shape>
            </item>

            <!-- Layer 2: slightly inner glow ring (tighter, brighter) -->
            <item android:left="1dp" android:top="1dp"
                  android:right="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#10E8A800"/>
                    <corners android:radius="17dp"/>
                </shape>
            </item>

            <!-- Layer 3: main card — very dark amber + vivid gold stroke -->
            <item android:left="3dp" android:top="3dp"
                  android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#1A1100"
                        android:endColor="#0D0900"
                        android:angle="135"/>
                    <stroke android:width="1.5dp" android:color="#E8A500"/>
                    <corners android:radius="15dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

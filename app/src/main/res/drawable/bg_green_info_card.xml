<?xml version="1.0" encoding="utf-8"?>
<!--
    GeoStamp Green Info Card — Matches the reference screenshot
    Solid dark green (#1B5E20 base) with lighter green tint,
    rounded corners, subtle white border for depth.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Solid green fill -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A6B3A"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

    <!-- Subtle white border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke android:width="1dp" android:color="#3AFFFFFF"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>

</layer-list>

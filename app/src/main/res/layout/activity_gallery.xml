<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#05080F">

    <!-- ── Header ── -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="6dp" android:paddingEnd="10dp"
        android:background="#0A0E1C">
        <ImageButton android:id="@+id/btn_back" android:layout_width="42dp" android:layout_height="42dp"
            android:src="@drawable/ic_back" android:tint="#94A3B8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"/>
        <TextView android:id="@+id/tv_gallery_title" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="2dp" android:text="EVIDENCE GALLERY"
            android:textColor="#F1F5F9" android:textSize="13sp" android:textStyle="bold"
            android:letterSpacing="0.1"/>
        <TextView android:id="@+id/tv_photo_pill" android:layout_width="wrap_content"
            android:layout_height="28dp" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:gravity="center" android:text="0 Photos" android:textColor="#07090F"
            android:textSize="10sp" android:textStyle="bold"
            android:background="@drawable/bg_chip_active_glow"/>
    </LinearLayout>

    <!-- ── Multi-selection action bar ── -->
    <LinearLayout android:id="@+id/selection_action_bar" android:layout_width="match_parent"
        android:layout_height="50dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="4dp"
        android:background="#091623" android:visibility="gone">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tv_selected_count" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0 Selected"
                android:textColor="#22D3EE" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tap to deselect" android:textColor="#334155" android:textSize="9sp"/>
        </LinearLayout>
        <!-- Action buttons -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout android:id="@+id/btn_select_all" android:layout_width="48dp"
                android:layout_height="50dp" android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@android:drawable/checkbox_on_background"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="All" android:textColor="#64748B" android:textSize="8sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btn_delete_selected" android:layout_width="48dp"
                android:layout_height="50dp" android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_delete"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Delete" android:textColor="#64748B" android:textSize="8sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btn_share_selected" android:layout_width="48dp"
                android:layout_height="50dp" android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_share"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Share" android:textColor="#64748B" android:textSize="8sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btn_export_selected" android:layout_width="48dp"
                android:layout_height="50dp" android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_export"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Export" android:textColor="#64748B" android:textSize="8sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/btn_cancel_selection" android:layout_width="48dp"
                android:layout_height="50dp" android:orientation="vertical" android:gravity="center"
                android:background="?attr/selectableItemBackgroundBorderless">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cancel" android:textColor="#64748B" android:textSize="8sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Filter tabs — slim glass style ── -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="42dp"
        android:scrollbars="none" android:background="#070A14">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="10dp" android:paddingEnd="10dp">

            <LinearLayout android:id="@+id/chip_by_site" android:layout_width="wrap_content"
                android:layout_height="28dp" android:orientation="horizontal" android:gravity="center"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:background="@drawable/bg_chip_active_glow" android:layout_marginEnd="7dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="⊞  BY SITE" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#07090F"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/chip_today" android:layout_width="wrap_content"
                android:layout_height="28dp" android:orientation="horizontal" android:gravity="center"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:background="@drawable/bg_chip_inactive_glass" android:layout_marginEnd="7dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="📅  TODAY" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#475569"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/chip_week" android:layout_width="wrap_content"
                android:layout_height="28dp" android:orientation="horizontal" android:gravity="center"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:background="@drawable/bg_chip_inactive_glass" android:layout_marginEnd="7dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🗓  THIS WEEK" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#475569"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/chip_search" android:layout_width="wrap_content"
                android:layout_height="28dp" android:orientation="horizontal" android:gravity="center"
                android:paddingStart="12dp" android:paddingEnd="12dp"
                android:background="@drawable/bg_chip_inactive_glass"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🔍  SEARCH" android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#475569"/>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- ── Search bar ── -->
    <LinearLayout android:id="@+id/search_bar_container" android:layout_width="match_parent"
        android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="10dp" android:background="#070A14"
        android:visibility="gone">
        <EditText android:id="@+id/et_search" android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:hint="Search site ID, operator, city…"
            android:textColor="#F1F5F9" android:textColorHint="#334155" android:textSize="12sp"
            android:background="@drawable/bg_search_field" android:paddingStart="14dp"
            android:paddingEnd="14dp" android:singleLine="true" android:imeOptions="actionSearch"
            android:inputType="text"/>
        <ImageButton android:id="@+id/btn_clear_search" android:layout_width="34dp"
            android:layout_height="34dp" android:layout_marginStart="6dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel" android:tint="#475569"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Clear" android:visibility="gone"/>
    </LinearLayout>

    <!-- ── Premium stats section ── -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp"
        android:orientation="horizontal" android:background="#070A14"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="4dp" android:paddingBottom="4dp">

        <!-- Photos stat card -->
        <LinearLayout android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:layout_marginEnd="4dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/bg_stat_card">
            <TextView android:id="@+id/tv_stat_photos" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textColor="#22D3EE" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PHOTOS" android:textColor="#334155"
                android:textSize="7sp" android:letterSpacing="0.14"/>
        </LinearLayout>

        <!-- Sites stat card -->
        <LinearLayout android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:layout_marginEnd="4dp"
            android:orientation="vertical" android:gravity="center"
            android:background="@drawable/bg_stat_card">
            <TextView android:id="@+id/tv_stat_sites" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0"
                android:textColor="#22D3EE" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SITES" android:textColor="#334155"
                android:textSize="7sp" android:letterSpacing="0.14"/>
        </LinearLayout>

        <!-- Verified stat card -->
        <LinearLayout android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:orientation="vertical" android:gravity="center"
            android:background="@drawable/bg_stat_card">
            <TextView android:id="@+id/tv_stat_verified" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="0%"
                android:textColor="#22D3EE" android:textSize="18sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TODAY" android:textColor="#334155"
                android:textSize="7sp" android:letterSpacing="0.14"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ── Breadcrumb ── -->
    <LinearLayout android:id="@+id/album_breadcrumb" android:layout_width="match_parent"
        android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:background="#0A1020"
        android:visibility="gone">
        <TextView android:id="@+id/btn_breadcrumb_back" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="← All Sites"
            android:textColor="#22D3EE" android:textSize="11sp" android:textStyle="bold"
            android:paddingEnd="10dp"/>
        <View android:layout_width="1dp" android:layout_height="12dp"
            android:background="#1E293B" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/tv_album_label" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#F1F5F9" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tv_album_count" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="#475569" android:textSize="10sp"/>
    </LinearLayout>

    <!-- ── Content ── -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_view"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingTop="4dp" android:paddingBottom="8dp" android:clipToPadding="false"/>

        <LinearLayout android:id="@+id/empty_state" android:layout_width="match_parent"
            android:layout_height="match_parent" android:orientation="vertical"
            android:gravity="center" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="&#128225;" android:textSize="56sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:text="No evidence captured yet"
                android:textColor="#94A3B8" android:textSize="15sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Capture field photos to build your evidence archive"
                android:textColor="#334155" android:textSize="12sp"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/progress_bar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:indeterminateTint="#22D3EE" android:visibility="gone"/>
    </FrameLayout>
</LinearLayout>

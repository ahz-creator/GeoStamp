<?xml version="1.0" encoding="utf-8"?>
<!-- GeoStamp Camera HUD v5.3
     CRITICAL: brand_header has NO margins (left/right/top = 0)
     Status-bar clearance: paddingTop="32dp" on brand_header_inner (static, no code needed)
     Flash+Flip: hidden dot on right side, expands on tap, collapses after selection
     top_row: anchored BELOW brand_header so overlay card cannot slide behind banner -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/camera_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Full-screen camera preview -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:scaleType="fillCenter"/>


    <!-- Rule-of-thirds grid overlay — custom View draws lines at 33%/66% -->
    <com.axiominfratech.geostamp.ui.GridOverlayView
        android:id="@+id/grid_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:elevation="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <!-- Orientation badge: V (portrait) or H (landscape) — top-right beside GPS -->
    <TextView
        android:id="@+id/tv_orientation_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="V"
        android:textColor="#22C55E"
        android:textSize="8sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:elevation="12dp"
        android:background="@drawable/bg_orient_portrait"
        app:layout_constraintTop_toBottomOf="@id/brand_header"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"/>

    <!-- ═══════════════════════════════════════════════════════════════
         BRAND HEADER — edge-to-edge, NO margins on any side
         paddingTop="32dp" = status bar clearance (no code needed)
         ═══════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/brand_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/brand_header_inner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="10dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_brand_header">

            <!-- GeoStamp logo PNG  (left 60%) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="3"
                android:src="@drawable/ic_geostamp_logo_left"
                android:scaleType="fitStart"
                android:adjustViewBounds="true"
                android:contentDescription="GeoStamp"/>

            <!-- Dot divider -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">
                <View android:layout_width="1dp" android:layout_height="10dp"
                    android:background="@drawable/bg_header_divider"/>
                <View android:layout_width="4dp" android:layout_height="4dp"
                    android:background="#408B5CF6"
                    android:layout_marginTop="3dp" android:layout_marginBottom="3dp"/>
                <View android:layout_width="1dp" android:layout_height="10dp"
                    android:background="@drawable/bg_header_divider"/>
            </LinearLayout>

            <!-- Axiom logo PNG  (right 40%) -->
            <ImageView
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="2"
                android:src="@drawable/ic_axiom_logo_right"
                android:scaleType="fitEnd"
                android:adjustViewBounds="true"
                android:contentDescription="Axiom Infratech"/>
        </LinearLayout>

        <!-- Bottom shimmer line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_header_shimmer_line"/>
    </FrameLayout>

    <!-- Invisible barrier: anchored to BOTTOM of brand_header.
         CameraFragment uses this as minY so info_overlay never slides behind the banner. -->
    <View android:id="@+id/top_row"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/brand_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ═══════════════════════════════════════════════════════════════
         GREEN INFO CARD (floating, draggable)
         ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/info_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_green_info_card"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/ic_dot_locked" app:tint="#4CAF50"
                android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tv_city_name_overlay"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Location Acquired" android:textColor="#FFFFFF"
                android:textSize="13sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  ⋮" android:textColor="#88FFFFFF" android:textSize="16sp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#33FFFFFF" android:layout_marginBottom="10dp"/>

        <TextView android:id="@+id/tv_coords"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–.–––° N,  –.–––° E"
            android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"
            android:fontFamily="monospace" android:layout_marginBottom="4dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <TextView android:id="@+id/tv_accuracy"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="± ––m" android:textColor="#B2DFDB" android:textSize="11sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  •  " android:textColor="#66FFFFFF" android:textSize="11sp"/>
            <TextView android:id="@+id/tv_accuracy_quality"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Medium" android:textColor="#FFD54F"
                android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#33FFFFFF" android:layout_marginBottom="10dp"/>

        <LinearLayout android:id="@+id/site_divider"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                android:src="@drawable/ic_sync" app:tint="#80FFFFFF"
                android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tv_datetime"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–– ––– ––––,  ––:––"
                android:textColor="#E0F2F1" android:textSize="12sp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#33FFFFFF" android:layout_marginBottom="10dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="10dp">
            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                android:src="@drawable/ic_layers" app:tint="#80FFFFFF"
                android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tv_overlay_primary_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Operator  " android:textColor="#B2DFDB" android:textSize="11sp"/>
            <TextView android:id="@+id/tv_site_name"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="#80DEEA"
                android:textSize="12sp" android:textStyle="bold"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#33FFFFFF" android:layout_marginBottom="10dp"/>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="12dp" android:layout_height="12dp"
                android:src="@drawable/ic_layers" app:tint="#CE93D8"
                android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tv_overlay_secondary_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Site ID  " android:textColor="#B2DFDB" android:textSize="11sp"/>
            <TextView android:id="@+id/tv_site_id_overlay"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="–" android:textColor="#CE93D8"
                android:textSize="12sp" android:textStyle="bold" android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Compact overlay strip -->
    <LinearLayout
        android:id="@+id/info_overlay_compact"
        android:layout_width="wrap_content" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:background="@drawable/bg_hud_pill"
        android:elevation="10dp" android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottom_info_strip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="16dp" android:layout_marginEnd="16dp">
        <TextView android:id="@+id/tv_compact_location"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="📍 Locating…" android:textColor="#FFFFFF" android:textSize="9sp"
            android:singleLine="true" android:ellipsize="end" android:layout_marginEnd="8dp"/>
        <View android:layout_width="1dp" android:layout_height="20dp"
            android:background="#33FFFFFF" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/tv_compact_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="––:––" android:textColor="#B0BEC5" android:textSize="10sp"
            android:fontFamily="monospace" android:layout_marginEnd="8dp"/>
        <View android:layout_width="1dp" android:layout_height="20dp"
            android:background="#33FFFFFF" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/tv_compact_operator"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="#00BCD4" android:textSize="10sp"
            android:textStyle="bold" android:layout_marginEnd="8dp"/>
        <View android:layout_width="1dp" android:layout_height="20dp"
            android:background="#33FFFFFF" android:layout_marginEnd="8dp"/>
        <TextView android:id="@+id/tv_compact_siteid"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="#CE93D8" android:textSize="10sp"
            android:fontFamily="monospace" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Bottom info strip -->
    <LinearLayout
        android:id="@+id/bottom_info_strip"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="8dp" android:paddingBottom="8dp"
        android:background="@drawable/bg_hud_pill" android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_panel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="20dp" android:layout_marginEnd="20dp">
        <TextView android:id="@+id/tv_strip_coords"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–.–°N, –.–°E" android:textColor="#FFFFFF"
            android:textSize="10sp" android:fontFamily="monospace" android:singleLine="true"/>
        <View android:layout_width="1dp" android:layout_height="18dp"
            android:background="#33FFFFFF" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/tv_strip_accuracy"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="±–m" android:textColor="#4CAF50"
            android:textSize="10sp" android:textStyle="bold"/>
        <View android:layout_width="1dp" android:layout_height="18dp"
            android:background="#33FFFFFF" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/tv_strip_time"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="––:––" android:textColor="#B0BEC5"
            android:textSize="10sp" android:fontFamily="monospace"/>
        <View android:layout_width="1dp" android:layout_height="18dp"
            android:background="#33FFFFFF" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/tv_strip_operator"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="#00BCD4"
            android:textSize="10sp" android:textStyle="bold"/>
        <View android:layout_width="1dp" android:layout_height="18dp"
            android:background="#33FFFFFF" android:layout_marginStart="10dp" android:layout_marginEnd="10dp"/>
        <TextView android:id="@+id/tv_strip_siteid"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="#CE93D8"
            android:textSize="10sp" android:fontFamily="monospace" android:textStyle="bold"/>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         RIGHT SIDEBAR — Flash · Flip · Grid · Timer
         Single tap = toggle open/close + auto-hide after 3 s
         Double tap = pin open (tap dot again to close)
         ═══════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/flash_flip_panel"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:elevation="9dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="6dp">

        <!-- Collapsed: glowing dot -->
        <LinearLayout
            android:id="@+id/flash_flip_trigger"
            android:layout_width="32dp" android:layout_height="32dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:background="@drawable/bg_hud_ctrl_btn"
            android:clickable="true" android:focusable="true">
            <View android:layout_width="9dp" android:layout_height="9dp"
                android:background="#CC8B5CF6"/>
        </LinearLayout>

        <!-- Expanded: compact 4-button card -->
        <LinearLayout
            android:id="@+id/flash_flip_expanded"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_hud_glass_card"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:paddingStart="4dp" android:paddingEnd="4dp"
            android:visibility="gone">

            <!-- Flash 3-state -->
            <LinearLayout android:id="@+id/btn_flash"
                android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:orientation="vertical"
                android:background="@drawable/bg_hud_ctrl_btn"
                android:clickable="true" android:focusable="true"
                android:layout_marginBottom="6dp">
                <ImageView android:id="@+id/ic_flash_state"
                    android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_flash" app:tint="#FFFFFF" android:alpha="0.45"/>
                <TextView android:id="@+id/tv_flash_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="OFF" android:textColor="#8B5CF6"
                    android:textSize="7sp" android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Flip Camera -->
            <LinearLayout android:id="@+id/btn_flip"
                android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:orientation="vertical"
                android:background="@drawable/bg_hud_ctrl_btn"
                android:clickable="true" android:focusable="true"
                android:layout_marginBottom="6dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_flip_camera" app:tint="#FFFFFF"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Flip" android:textColor="#80FFFFFF"
                    android:textSize="7sp" android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Grid toggle -->
            <LinearLayout android:id="@+id/btn_grid"
                android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:orientation="vertical"
                android:background="@drawable/bg_hud_ctrl_btn"
                android:clickable="true" android:focusable="true"
                android:layout_marginBottom="6dp">
                <ImageView android:id="@+id/ic_grid_state"
                    android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_grid_on" app:tint="#FFFFFF" android:alpha="0.45"/>
                <TextView android:id="@+id/tv_grid_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Grid" android:textColor="#8B5CF6"
                    android:textSize="7sp" android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- Timer -->
            <LinearLayout android:id="@+id/btn_timer"
                android:layout_width="48dp" android:layout_height="48dp"
                android:gravity="center" android:orientation="vertical"
                android:background="@drawable/bg_hud_ctrl_btn"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/ic_timer_state"
                    android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/ic_timer" app:tint="#FFFFFF" android:alpha="0.45"/>
                <TextView android:id="@+id/tv_timer_label"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="OFF" android:textColor="#8B5CF6"
                    android:textSize="7sp" android:textStyle="bold"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

        </LinearLayout>
    </FrameLayout>

    <!-- Active workspace selector: Personal or Organization -->
    <LinearLayout
        android:id="@+id/workspace_selector"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_workspace_pill"
        android:elevation="12dp"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginTop="6dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintTop_toBottomOf="@id/brand_header"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_workspace_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ORGANIZATION  •  SELECT OPERATOR"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  ▾"
            android:textColor="#40C4FF"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- Discreet integrity marker shown when location risk is detected -->
    <TextView
        android:id="@+id/tv_integrity_marker"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:gravity="center"
        android:text="F"
        android:textColor="#FF5252"
        android:textSize="9sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="@drawable/bg_integrity_marker"
        android:visibility="gone"
        android:elevation="14dp"
        android:contentDescription="Location integrity warning"
        app:layout_constraintTop_toBottomOf="@id/brand_header"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="7dp"
        android:layout_marginTop="7dp"/>

    <!-- ═══════════════════════════════════════════════════════════════
         BOTTOM CONTROLS PANEL
         paddingBottom="52dp" covers Samsung 3-button nav bar (~48dp)
         ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_hud_bottom_panel"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constrainedHeight="true">

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#33FFFFFF"/>

        <LinearLayout
            android:id="@+id/bottom_panel_inner"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- LEFT: Gallery + Settings -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <LinearLayout android:id="@+id/btn_gallery_nav"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_hud_ctrl_btn"
                    android:layout_marginBottom="6dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_gallery" android:layout_marginBottom="3dp"
                        app:tint="#29B6F6"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Gallery" android:textColor="#29B6F6"
                        android:textSize="9sp" android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/btn_switch_side"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="vertical" android:gravity="center"
                    android:background="@drawable/bg_hud_ctrl_btn"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:src="@drawable/ic_settings" android:layout_marginBottom="3dp"
                        app:tint="#AB47BC"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Settings" android:textColor="#AB47BC"
                        android:textSize="9sp" android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CENTER: Shutter -->
            <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="center">
                <ProgressBar android:id="@+id/capture_progress"
                    android:layout_width="78dp" android:layout_height="78dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/brand_blue"
                    android:visibility="gone"/>
                <ImageButton android:id="@+id/btn_capture"
                    android:layout_width="78dp" android:layout_height="78dp"
                    android:src="@drawable/ic_shutter"
                    android:background="@drawable/bg_shutter_outer"
                    android:layout_gravity="center"
                    android:padding="18dp"
                    android:contentDescription="Capture"/>
            </FrameLayout>

            <!-- RIGHT: Operator + Site ID -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="8dp">

                <LinearLayout android:id="@+id/card_operator_tap"
                    android:contentDescription="Verify received evidence"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="10dp" android:paddingEnd="8dp"
                    android:background="@drawable/bg_hud_selector_cyan"
                    android:layout_marginBottom="6dp"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp"
                        android:src="@drawable/ic_verify_evidence" android:layout_marginEnd="5dp"
                        app:tint="#00BCD4"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tv_primary_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Verify" android:textColor="#66FFFFFF"
                            android:textSize="8sp" android:letterSpacing="0.06"/>
                        <TextView android:id="@+id/tv_operator_display"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Scan or ID" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▾" android:textColor="#00BCD4" android:textSize="13sp"/>
                </LinearLayout>

                <LinearLayout android:id="@+id/card_site_tap"
                    android:contentDescription="Site ID"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="10dp" android:paddingEnd="8dp"
                    android:background="@drawable/bg_hud_selector_purple"
                    android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="13dp" android:layout_height="13dp"
                        android:src="@drawable/ic_layers" android:layout_marginEnd="5dp"
                        app:tint="#CE93D8"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/tv_secondary_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Site ID" android:textColor="#66FFFFFF"
                            android:textSize="8sp" android:letterSpacing="0.06"/>
                        <TextView android:id="@+id/tv_site_display"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Auto" android:textColor="#CE93D8"
                            android:textSize="13sp" android:textStyle="bold"
                            android:fontFamily="monospace"/>
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="▾" android:textColor="#CE93D8" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>



    <!-- Shutter flash — briefly blinks white on capture, always GONE except during flash -->
    <View
        android:id="@+id/shutter_flash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFFFF"
        android:visibility="gone"
        android:elevation="30dp"
        android:clickable="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Timer countdown overlay -->
    <FrameLayout
        android:id="@+id/timer_countdown_overlay"
        android:layout_width="0dp" android:layout_height="0dp"
        android:elevation="20dp"
        android:background="#88000000"
        android:visibility="gone"
        android:clickable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:id="@+id/tv_countdown"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="3"
            android:textColor="#FFFFFF"
            android:textSize="96sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>
    </FrameLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         INVISIBLE BINDING STUBS — do not remove, required by CameraFragment.kt
         ═══════════════════════════════════════════════════════════════ -->
    <View android:id="@+id/top_accent_line" android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/tv_location_error"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:padding="5dp" android:paddingStart="14dp"
        android:textColor="#FCA5A5" android:textSize="10sp"
        android:background="#CC7F1D1D" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView android:id="@+id/tv_site_id" android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/tv_city_name" android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.chip.Chip android:id="@+id/chip_operator"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/tv_db_count" android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <ImageButton android:id="@+id/btn_stamp_options"
        android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone" android:contentDescription="Stamp options"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <ImageButton android:id="@+id/btn_menu"
        android:layout_width="0dp" android:layout_height="0dp"
        android:visibility="gone" android:contentDescription="Menu"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/gps_indicator"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <TextView android:id="@+id/tv_layout_label"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <!-- Sidebar stubs needed if old code referenced them -->
    <LinearLayout android:id="@+id/btn_flash_layout"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>
    <ImageView android:id="@+id/iv_operator_logo"
        android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stamp_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="#07101F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="68dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="6dp">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHOTO STAMP SETTINGS"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GeoStamp by Axiom Infratech"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_subtle" />

    <ScrollView
        android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingBottom="28dp"
            android:animateLayoutChanges="true">

            <LinearLayout
                android:id="@+id/section_site_header"
                style="@style/GeoStampAccordionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    style="@style/GeoStampHeaderTextGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:id="@+id/tv_site_title"
                        style="@style/GeoStampAccordionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SITE &amp; ORGANIZATION" />
                    <TextView
                        android:id="@+id/tv_site_summary"
                        style="@style/GeoStampAccordionSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Axiom Infratech · Site match 1 km" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_site_chevron"
                    style="@style/GeoStampChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌄" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_site_content"
                style="@style/GeoStampAccordionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/GeoStampLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organization" />
                <TextView
                    android:id="@+id/tv_organization"
                    style="@style/GeoStampValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Axiom Infratech" />
                <View style="@style/GeoStampDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />
                <TextView
                    style="@style/GeoStampLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organization selection" />
                <TextView
                    android:id="@+id/tv_org_logic"
                    style="@style/GeoStampValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatic from verified site/session" />
                <View style="@style/GeoStampDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />
                <LinearLayout
                    style="@style/GeoStampPolicyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        style="@style/GeoStampHeaderTextGroup"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            style="@style/GeoStampLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Site matching distance" />
                        <TextView
                            android:id="@+id/tv_radius_value"
                            style="@style/GeoStampValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1 km" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:contentDescription="Managed by your organization"
                        android:textSize="18sp" />
                </LinearLayout>
                <TextView
                    style="@style/GeoStampHelper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Managed by your organization" />
                <View style="@style/GeoStampDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />
                <TextView
                    style="@style/GeoStampLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current matching status" />
                <TextView
                    android:id="@+id/tv_site_status"
                    style="@style/GeoStampValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Automatic site matching active" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_saved_header"
                style="@style/GeoStampAccordionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    style="@style/GeoStampHeaderTextGroup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView style="@style/GeoStampAccordionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SAVED PHOTO STAMP" />
                    <TextView
                        android:id="@+id/tv_saved_summary"
                        style="@style/GeoStampAccordionSummary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Card · Standard · 80% · Dark" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_saved_chevron"
                    style="@style/GeoStampChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⌃" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_saved_content"
                style="@style/GeoStampAccordionContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView style="@style/GeoStampLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Layout" />
                <RadioGroup
                    android:id="@+id/group_layout"
                    style="@style/GeoStampSegmentGroup"
                    android:layout_width="match_parent"
                    android:layout_height="36dp">
                    <RadioButton android:id="@+id/radio_layout_card" style="@style/GeoStampSegment"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="Card" />
                    <RadioButton android:id="@+id/radio_layout_strip" style="@style/GeoStampSegment"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="Strip" />
                    <RadioButton android:id="@+id/radio_layout_footer" style="@style/GeoStampSegment"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="Footer" />
                </RadioGroup>

                <TextView style="@style/GeoStampLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="Stamp size" />
                <RadioGroup
                    android:id="@+id/group_size"
                    style="@style/GeoStampSegmentGroup"
                    android:layout_width="match_parent" android:layout_height="36dp">
                    <RadioButton android:id="@+id/radio_size_compact" style="@style/GeoStampSegment"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="Compact" />
                    <RadioButton android:id="@+id/radio_size_standard" style="@style/GeoStampSegment"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="Standard" />
                    <RadioButton android:id="@+id/radio_size_large" style="@style/GeoStampSegment"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="Large" />
                </RadioGroup>

                <LinearLayout style="@style/GeoStampRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp">
                    <TextView style="@style/GeoStampLabel"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Stamp opacity" />
                    <TextView android:id="@+id/tv_alpha_value" style="@style/GeoStampValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="80%" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_overlay_alpha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="20"
                    android:valueTo="90"
                    android:stepSize="1" />

                <LinearLayout style="@style/GeoStampSliderLabels"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView style="@style/GeoStampHelper"
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Transparent" />
                    <TextView style="@style/GeoStampHelper"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Solid" />
                </LinearLayout>

                <TextView style="@style/GeoStampLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" android:text="Theme" />
                <RadioGroup
                    android:id="@+id/group_theme"
                    style="@style/GeoStampSegmentGroup"
                    android:layout_width="match_parent" android:layout_height="36dp">
                    <RadioButton android:id="@+id/radio_theme_dark" style="@style/GeoStampSegment"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="Dark" />
                    <RadioButton android:id="@+id/radio_theme_light" style="@style/GeoStampSegment"
                        android:layout_width="0dp" android:layout_height="match_parent"
                        android:layout_weight="1" android:text="Light" />
                </RadioGroup>

                <TextView style="@style/GeoStampLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" android:text="Preview" />

                <FrameLayout
                    android:id="@+id/preview_frame"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:background="#000000"
                    android:padding="12dp">
                    <LinearLayout
                        android:id="@+id/overlay_preview_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView android:id="@+id/preview_status"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="✓ Location verified" android:textStyle="bold" android:textSize="13sp" />
                        <TextView android:id="@+id/preview_coords"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="24.8610° N, 67.0101° E" android:textStyle="bold" android:textSize="15sp"
                            android:layout_marginTop="3dp" />
                        <TextView android:id="@+id/preview_time"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="02 May 2026, 14:30" android:textSize="11sp" />
                        <TextView android:id="@+id/preview_site"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Site ID: PKZ-KHI-001" android:textSize="11sp" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_info_header"
                style="@style/GeoStampAccordionHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/GeoStampHeaderTextGroup"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView style="@style/GeoStampAccordionTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="INFORMATION DISPLAYED" />
                    <TextView android:id="@+id/tv_info_summary" style="@style/GeoStampAccordionSummary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Organization fields managed · Evidence fields required" />
                </LinearLayout>
                <TextView android:id="@+id/tv_info_chevron" style="@style/GeoStampChevron"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌄" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_info_content"
                style="@style/GeoStampAccordionContent"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView style="@style/GeoStampSectionMini"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="REQUIRED ORGANIZATION FIELDS" />
                <TextView style="@style/GeoStampValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Organization · Managed" />
                <TextView style="@style/GeoStampValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Site ID · Managed" />
                <TextView style="@style/GeoStampValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Capture time · Required" />
                <TextView style="@style/GeoStampValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Location · Required" />
                <TextView style="@style/GeoStampValue"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Evidence ID · Required" />
                <View style="@style/GeoStampDivider"
                    android:layout_width="match_parent" android:layout_height="1dp" />
                <TextView style="@style/GeoStampSectionMini"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="OPTIONAL USER-CONTROLLED FIELDS" />
                <TextView style="@style/GeoStampHelper"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="No optional field visibility controls are currently exposed by this version. Existing stamp fields remain unchanged." />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_camera_header"
                style="@style/GeoStampAccordionHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/GeoStampHeaderTextGroup"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView style="@style/GeoStampAccordionTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CAMERA SCREEN" />
                    <TextView android:id="@+id/tv_camera_summary" style="@style/GeoStampAccordionSummary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Floating Info Card" />
                </LinearLayout>
                <TextView android:id="@+id/tv_camera_chevron" style="@style/GeoStampChevron"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌄" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_camera_content"
                style="@style/GeoStampAccordionContent"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <RadioGroup
                    android:id="@+id/group_live_info"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <RadioButton android:id="@+id/radio_live_floating" style="@style/GeoStampRadio"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="Floating Info Card" />
                    <RadioButton android:id="@+id/radio_live_bottom" style="@style/GeoStampRadio"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="Bottom Info Strip" />
                    <RadioButton android:id="@+id/radio_live_off" style="@style/GeoStampRadio"
                        android:layout_width="match_parent" android:layout_height="48dp"
                        android:text="Off" />
                </RadioGroup>
                <TextView style="@style/GeoStampHelper"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Controls the information shown while taking a photo. It does not remove information required on the saved photo."
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_protection_header"
                style="@style/GeoStampAccordionHeader"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/GeoStampHeaderTextGroup"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView style="@style/GeoStampAccordionTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="CAPTURE PROTECTION" />
                    <TextView android:id="@+id/tv_protection_summary" style="@style/GeoStampAccordionSummary"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Location trust protection" />
                </LinearLayout>
                <TextView android:id="@+id/tv_protection_chevron" style="@style/GeoStampChevron"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌄" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/section_protection_content"
                style="@style/GeoStampAccordionContent"
                android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout style="@style/GeoStampRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout style="@style/GeoStampHeaderTextGroup"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                        <TextView style="@style/GeoStampValue"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Prevent capture with an untrusted location" />
                        <TextView style="@style/GeoStampHelper"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="GeoStamp will block photo capture when a mock or manipulated location is detected." />
                    </LinearLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_block_spoof"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Prevent capture with an untrusted location" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_protection_managed"
                    style="@style/GeoStampHelper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:layout_marginTop="8dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/tv_auto_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:text="Changes are saved automatically"
        android:textSize="11sp"
        android:textColor="@color/text_secondary" />
</LinearLayout>

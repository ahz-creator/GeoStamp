<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#0E1522"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Thumbnail with overlays -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <ImageView
                android:id="@+id/iv_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Evidence photo"/>

            <!-- Dark gradient scrim at bottom of image -->
            <View
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_scrim_bottom"/>

            <!-- GPS Badge top-right -->
            <TextView
                android:id="@+id/tv_gps_badge"
                android:layout_width="wrap_content"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:gravity="center"
                android:text="✓ GPS"
                android:textColor="#22C55E"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_gps_badge"/>

            <!-- Coordinates at bottom of image -->
            <TextView
                android:id="@+id/tv_coords_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="5dp"
                android:text="–°N  –°E"
                android:textColor="#9DD9F3"
                android:textSize="9sp"
                android:fontFamily="monospace"/>
        </FrameLayout>

        <!-- Info section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <!-- Site ID — large bold -->
            <TextView
                android:id="@+id/tv_site_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.02"/>

            <!-- Date · Time -->
            <TextView
                android:id="@+id/tv_date_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="–"
                android:textColor="#64748B"
                android:textSize="10sp"/>

            <!-- Operator -->
            <TextView
                android:id="@+id/tv_operator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="–"
                android:textColor="#22D3EE"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>

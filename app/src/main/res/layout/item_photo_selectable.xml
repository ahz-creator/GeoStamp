<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_margin="4dp" app:cardCornerRadius="16dp"
    app:cardBackgroundColor="#0E1829" app:cardElevation="4dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout android:layout_width="match_parent" android:layout_height="155dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_thumb"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:scaleType="centerCrop" android:contentDescription="Evidence photo"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner16"/>

            <!-- Selection tint overlay -->
            <View android:id="@+id/selection_overlay" android:layout_width="match_parent"
                android:layout_height="match_parent" android:background="#660EA5E9"
                android:visibility="gone"/>

            <!-- Checkbox -->
            <CheckBox android:id="@+id/cb_select" android:layout_width="24dp" android:layout_height="24dp"
                android:layout_gravity="top|start" android:layout_margin="7dp"
                android:background="@drawable/bg_check_box" android:button="@null"
                android:visibility="gone"/>

            <!-- GPS badge — top right, refined -->
            <TextView android:id="@+id/tv_gps_badge"
                android:layout_width="wrap_content" android:layout_height="18dp"
                android:layout_gravity="top|end" android:layout_margin="7dp"
                android:paddingStart="6dp" android:paddingEnd="6dp" android:gravity="center"
                android:text="✓ GPS" android:textColor="#22C55E"
                android:textSize="8sp" android:textStyle="bold"
                android:background="@drawable/bg_gps_badge_refined"/>

            <!-- Strong bottom scrim -->
            <View android:layout_width="match_parent" android:layout_height="60dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_scrim_bottom_strong"/>

            <!-- Coords overlay — bottom -->
            <TextView android:id="@+id/tv_coords_overlay"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingBottom="6dp"
                android:textColor="#A0C8E0" android:textSize="8sp" android:fontFamily="monospace"/>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="8dp" android:paddingBottom="10dp">
            <TextView android:id="@+id/tv_site_id" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textColor="#22D3EE"
                android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tv_date_time" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="2dp"
                android:textColor="#3D6A7A" android:textSize="9sp"/>
            <TextView android:id="@+id/tv_operator" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:textColor="#4A6A80" android:textSize="9sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>

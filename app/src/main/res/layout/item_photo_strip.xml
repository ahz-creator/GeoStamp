<?xml version="1.0" encoding="utf-8"?>
<!-- Larger, premium strip photo — 100dp wide, 104dp tall, 14dp corners -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="100dp" android:layout_height="104dp"
    android:layout_marginEnd="8dp">

    <!-- Main image — rounded corners via ShapeableImageView -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_strip_thumb"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:background="#0A0F1C"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Corner10"
        android:contentDescription="Evidence photo"/>

    <!-- Selection checkbox -->
    <CheckBox android:id="@+id/cb_select" android:layout_width="22dp" android:layout_height="22dp"
        android:layout_gravity="top|start" android:layout_margin="5dp"
        android:background="@drawable/bg_check_box" android:button="@null"
        android:visibility="gone"/>

    <!-- GPS badge — top right, refined smaller -->
    <TextView android:id="@+id/tv_strip_gps"
        android:layout_width="wrap_content" android:layout_height="16dp"
        android:layout_gravity="top|end" android:layout_margin="5dp"
        android:paddingStart="5dp" android:paddingEnd="5dp" android:gravity="center"
        android:text="✓GPS" android:textColor="#22C55E"
        android:textSize="7sp" android:textStyle="bold"
        android:background="@drawable/bg_gps_badge_refined"/>

    <!-- Bottom gradient scrim — strong -->
    <View android:layout_width="match_parent" android:layout_height="44dp"
        android:layout_gravity="bottom"
        android:background="@drawable/gradient_scrim_bottom_strong"/>

    <!-- Coords + time at bottom -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:paddingStart="5dp" android:paddingEnd="5dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/tv_strip_coords"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="#A0C8E0"
            android:textSize="6sp" android:fontFamily="monospace" android:maxLines="2"
            android:lineSpacingMultiplier="1.1"/>
        <TextView android:id="@+id/tv_strip_time"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="#305060"
            android:textSize="7sp" android:layout_marginTop="1dp"/>
    </LinearLayout>
</FrameLayout>

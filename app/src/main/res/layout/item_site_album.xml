<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#0E1522"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 2x2 mini-grid preview -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:columnCount="2"
                android:rowCount="2">

                <ImageView android:id="@+id/iv_thumb1"
                    android:layout_width="0dp" android:layout_height="70dp"
                    android:layout_columnWeight="1" android:scaleType="centerCrop"
                    android:layout_marginEnd="1dp" android:layout_marginBottom="1dp"
                    android:contentDescription="Photo 1"/>
                <ImageView android:id="@+id/iv_thumb2"
                    android:layout_width="0dp" android:layout_height="70dp"
                    android:layout_columnWeight="1" android:scaleType="centerCrop"
                    android:layout_marginBottom="1dp"
                    android:contentDescription="Photo 2"/>
                <ImageView android:id="@+id/iv_thumb3"
                    android:layout_width="0dp" android:layout_height="70dp"
                    android:layout_columnWeight="1" android:scaleType="centerCrop"
                    android:layout_marginEnd="1dp"
                    android:contentDescription="Photo 3"/>
                <ImageView android:id="@+id/iv_thumb4"
                    android:layout_width="0dp" android:layout_height="70dp"
                    android:layout_columnWeight="1" android:scaleType="centerCrop"
                    android:contentDescription="Photo 4"/>
            </GridLayout>

            <!-- Count badge top-right -->
            <TextView
                android:id="@+id/tv_album_photo_count"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:gravity="center"
                android:text="0 photos"
                android:textColor="#F1F5F9"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_dark"/>

            <!-- Dark gradient scrim -->
            <View
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                android:background="@drawable/gradient_scrim_bottom"/>
        </FrameLayout>

        <!-- Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_album_site_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="–"
                android:textColor="#F1F5F9"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_album_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="–"
                android:textColor="#64748B"
                android:textSize="10sp"/>

            <TextView
                android:id="@+id/tv_album_operator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="–"
                android:textColor="#22D3EE"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
